# Node 20 is EOL and below the floor of the current toolchain (jsdom 30 requires
# >=22.22). pnpm downloads and uses this version for all scripts in this repo, so
# no global Node install has to change.
use-node-version=24.19.0

# Fail fast if the local pnpm major differs from the pinned packageManager.
engine-strict=true

# Keep the dependency tree strict: only declared dependencies are importable.
# This is what stops a transitive package from silently becoming an import.
hoist=false
