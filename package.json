{
  "name": "chrome-deployment-windows",
  "version": "2.5.0",
  "description": "Chrome extension that surfaces deployment window reminders on sites such as GitHub and Jira.",
  "license": "BSD-3-Clause",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "harness": "vite --config vite.harness.config.ts",
    "harness:build": "vite build --config vite.harness.config.ts",
    "build": "vite build",
    "preview": "vite preview",
    "package": "pnpm build && node scripts/package.js",
    "icons": "node scripts/icons.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm typecheck && pnpm lint && pnpm check:locales && pnpm test",
    "check:locales": "node scripts/check-locales.js",
    "check:manifest": "node scripts/check-manifest.js",
    "check:bundle": "node scripts/check-bundle.js",
    "check:payload": "node scripts/check-payload.js",
    "check:deps": "pnpm audit --prod --audit-level low && pnpm audit --audit-level high"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@uiw/react-codemirror": "^4.25.11",
    "dayjs": "^1.11.23",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/chrome": "^0.2.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
